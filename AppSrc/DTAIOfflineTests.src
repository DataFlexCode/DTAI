// DTAIOfflineTests.src
// Offline (no network, no API keys used) tests for the DTAI tool-calling groundwork.
// Compiles and runs on DataFlex 19.1 and 25.0. Writes PASS/FAIL lines to
// DTAIOfflineTests.txt in the current directory, then exits.
// See tool_calls_plan.md, "Test Plan - offline tests".
Use DFAllEnt.pkg

Object oApplication is a cApplication
End_Object

Use claudeai.pkg
Use geminiai.pkg
Use grokai.pkg
Use chatgptai.pkg
Use cAIDemoToolSet.pkg

Object oTestTools is a cAIToolSet
    Object oAddTool is a cAITool
        Set psName to "add_numbers"
        Set psDescription to "Adds a and b"
        Set psParametersJson to '{"type":"object","properties":{"a":{"type":"number"},"b":{"type":"number"}},"required":["a","b"]}'

        Function Execute Handle hoArgs tAIToolCall ToolCall Returns String
            Number nA nB
            Get MemberValue of hoArgs "a" to nA
            Get MemberValue of hoArgs "b" to nB
            Function_Return ('{"sum":'+String(nA+nB)+'}')
        End_Function
    End_Object

    Object oFailTool is a cAITool
        Set psName to "always_fails"
        Set psDescription to "Always reports an error"
        Set pbRequiresConfirmation to True

        Function Execute Handle hoArgs tAIToolCall ToolCall Returns String
            Send ToolError "Weather service unavailable"
            Function_Return ''
        End_Function
    End_Object

    Object oDisabledTool is a cAITool
        Set psName to "disabled_tool"
        Set pbEnabled to False
    End_Object
End_Object

Object oConvA is a cAIConversation
    Set psAssistantLabel to "Claude"
End_Object

Object oConvB is a cAIConversation
    Set psAssistantLabel to "Grok"
End_Object

Object oTranscript is a cAITranscript
End_Object

//=============================================================================
// Phase 2/3: saved Claude response samples and a fake Claude provider whose
// MakeRequestJSON returns queued samples instead of calling the API.
//=============================================================================

// one Claude Messages API response
Function ClaudeSample Global String sContent String sStopReason Returns String
    Function_Return ('{"id":"msg_test","type":"message","role":"assistant","model":"claude-test","content":[' + sContent + '],"stop_reason":"' + sStopReason + '","stop_sequence":null,"usage":{"input_tokens":100,"output_tokens":50}}')
End_Function

Function SampleToolUse Global String sId String sName String sInput Returns String
    Function_Return ('{"type":"tool_use","id":"' + sId + '","name":"' + sName + '","input":' + sInput + '}')
End_Function

Function SampleTextBlock Global String sText Returns String
    Function_Return ('{"type":"text","text":"' + sText + '"}')
End_Function

Global_Variable Integer giNotes

Class cFakeClaude is a cClaudeInterface

    Procedure Construct_Object
        Forward Send Construct_Object
        Property String[] paFakeResponses
        Property Integer  piFakeNext 0
        Property String[] paSentRequests
        Property Integer  piConfirmAnswer AI_CONFIRM_DEFER
        Property Integer  piConfirmAsked 0
    End_Procedure

    Procedure QueueResponses String[] aResponses
        String[] aEmpty
        Set paFakeResponses to aResponses
        Set piFakeNext to 0
        Set paSentRequests to aEmpty
        Set piConfirmAsked to 0
        Send ClearConversation
        Send ClearToolLoopState
        Send ClearLastError
    End_Procedure

    Function SentRequest Integer iIndex Returns String
        String[] aSent
        Get paSentRequests to aSent
        If (iIndex<SizeOfArray(aSent)) Function_Return aSent[iIndex]
        Function_Return ''
    End_Function

    // no network: record the request, return the next queued response
    Function MakeRequestJSON Handle hoRequest Returns Handle
        String[] aResponses aSent
        String sJson
        Integer iNext
        Handle hoResponse
        Boolean bOk
        Send ClearLastError
        Set peWhiteSpace of hoRequest to jpWhitespace_Plain
        Get Stringify of hoRequest to sJson
        Get paSentRequests to aSent
        Move (Replaces("\/",sJson,"/")) to aSent[SizeOfArray(aSent)]
        Set paSentRequests to aSent
        Get paFakeResponses to aResponses
        Get piFakeNext to iNext
        If (iNext>=SizeOfArray(aResponses)) Begin
            Send ReportAIError AI_ERR_TRANSFER "No more fake responses" "Transfer failed!"
            Function_Return 0
        End
        Set piFakeNext to (iNext+1)
        Get Create (RefClass(cJsonObject)) to hoResponse
        Get ParseString of hoResponse aResponses[iNext] to bOk
        If (not(bOk)) Begin
            Send Destroy of hoResponse
            Send ReportAIError AI_ERR_PARSE "Fake response is not JSON" "Parse"
            Function_Return 0
        End
        Function_Return hoResponse
    End_Function

    Function OnConfirmToolCall tAIToolCall ToolCall Returns Integer
        Set piConfirmAsked to (piConfirmAsked(Self)+1)
        Function_Return (piConfirmAnswer(Self))
    End_Function

End_Class

