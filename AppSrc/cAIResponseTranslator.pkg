//=============================================================================
// AI Response Translation Classes
// Purpose: Convert individual AI response structures to unified tAIResponse
//=============================================================================

Use ai.h
Use cJsonObject.pkg
Use chatgptai.h
Use claudeai.h 
Use geminiai.h

//=============================================================================
// Shared helpers (tool_calls_plan.md): normalized stop reason and joined text
//=============================================================================

// provider finish/stop reason -> AI_STOP_*
Function AIStopReasonFromProvider Global String sReason Returns Integer
    String sLower
    Move (Lowercase(Trim(sReason))) to sLower
    If (sLower='') Function_Return AI_STOP_UNKNOWN
    If (sLower='stop' or sLower='end_turn' or sLower='stop_sequence') Function_Return AI_STOP_END_TURN
    If (sLower='tool_calls' or sLower='function_call' or sLower='tool_use') Function_Return AI_STOP_TOOL_CALLS
    If (sLower='length' or sLower='max_tokens') Function_Return AI_STOP_MAX_TOKENS
    If (sLower='content_filter' or sLower='refusal' or sLower='safety' or sLower='recitation') Function_Return AI_STOP_CONTENT_FILTER
    If (sLower='prohibited_content' or sLower='blocklist' or sLower='spii') Function_Return AI_STOP_CONTENT_FILTER
    If (sLower='image_safety' or sLower='image_prohibited_content') Function_Return AI_STOP_CONTENT_FILTER
    If (sLower='malformed_function_call' or sLower='unexpected_tool_call' or sLower='too_many_tool_calls') Function_Return AI_STOP_ERROR
    Function_Return AI_STOP_UNKNOWN
End_Function

// JSON text -> plain re-stringified JSON object text; '' when it is not a JSON object
Function AINormalizeJsonObject Global String sJson Returns String
    Handle hoJson
    Boolean bParsed
    String sRetVal
    Get Create of Desktop (RefClass(cJsonObject)) to hoJson
    Get ParseString of hoJson sJson to bParsed
    If (bParsed) Begin
        If (JsonType(hoJson)=jsonTypeObject) Begin
            Set peWhiteSpace of hoJson to jpWhitespace_Plain
            Get Stringify of hoJson to sRetVal
        End
    End
    Send Destroy of hoJson
    Function_Return sRetVal
End_Function

// fills eStopReason and sText of a translated response (choice 0)
Function AIFinalizeResponse Global tAIResponse aiResponse Returns tAIResponse
    String sReason sText
    Integer i
    If (SizeOfArray(aiResponse.Choices)=0) Function_Return aiResponse
    Move aiResponse.Choices[0].sStopReason to sReason
    If (sReason='') Move aiResponse.Choices[0].sFinishReason to sReason
    Move (AIStopReasonFromProvider(sReason)) to aiResponse.eStopReason
    For i from 0 to (SizeOfArray(aiResponse.Choices[0].ContentParts)-1)
        If (aiResponse.Choices[0].ContentParts[i].sType='text') Begin
            Move (sText+aiResponse.Choices[0].ContentParts[i].sText) to sText
        End
        // tool parts mean "run tools" unless the turn was cut off or filtered
        If (aiResponse.Choices[0].ContentParts[i].sType='tool_use' or aiResponse.Choices[0].ContentParts[i].sType='tool_call') Begin
            If (aiResponse.eStopReason=AI_STOP_END_TURN or aiResponse.eStopReason=AI_STOP_UNKNOWN) Move AI_STOP_TOOL_CALLS to aiResponse.eStopReason
        End
    Loop
    Move sText to aiResponse.sText
    Function_Return aiResponse
End_Function

//=============================================================================
// ChatGPT Response Translator
//=============================================================================
Class cChatGPTTranslator is a cObject
    
    // Translates ChatGPT response to unified AI response structure
    Function TranslateToUnified tChatGPTResponse chatGPTResponse Returns tAIResponse
        tAIResponse aiResponse
        tAIChoice aiChoice
        tAIResponseContentPart contentPart
        Integer i
        
        // Map basic response fields
        Move chatGPTResponse.id to aiResponse.sId
        Move chatGPTResponse.Object to aiResponse.sObjectOrType
        // following line commented out temporariliy, this is likely a unix integer time that needs to be converted to datetime
        // Move chatGPTResponse.created to aiResponse.dtCreated
        Move chatGPTResponse.model to aiResponse.sModel
        Move "" to aiResponse.sRole // ChatGPT doesn't have a top-level role
        
        // Map usage information
        Move chatGPTResponse.usage.prompt_tokens to aiResponse.Usage.iPromptTokens
        Move chatGPTResponse.usage.completion_tokens to aiResponse.Usage.iCompletionTokens
        Move chatGPTResponse.usage.total_tokens to aiResponse.Usage.iTotalTokens
        Move chatGPTResponse.usage.completion_tokens to aiResponse.Usage.iOutputTokens
        Move chatGPTResponse.usage.prompt_tokens to aiResponse.Usage.iInputTokens
        Move 0 to aiResponse.Usage.iCacheCreationInputTokens
        Move 0 to aiResponse.Usage.iCacheReadInputTokens
        Move "" to aiResponse.Usage.sServiceTier
        
        // Map choices
        For i from 0 to (SizeOfArray(chatGPTResponse.choices) - 1)
            Move chatGPTResponse.choices[i].Index to aiChoice.iIndex
            Move chatGPTResponse.choices[i].finish_reason to aiChoice.sFinishReason
            Move "" to aiChoice.sStopReason
            Move "" to aiChoice.sStopSequence
            
            // Create content part from message
            Move "text" to contentPart.sType
            Move chatGPTResponse.choices[i].message.role to contentPart.sRole
            Move chatGPTResponse.choices[i].message.content to contentPart.sText
            Move "" to contentPart.sMimeType
            Move "" to contentPart.sData
            Move "" to contentPart.sFunctionName
            Move "" to contentPart.sFunctionArgs
            Move "" to contentPart.sFunctionContent
            
            Move contentPart to aiChoice.ContentParts[0]
            Move aiChoice to aiResponse.Choices[i]
        Loop
        
        Move (AIFinalizeResponse(aiResponse)) to aiResponse
        Function_Return aiResponse
    End_Function

    // Chat Completions response (JSON handle, not destroyed) -> tAIResponse with
    // ToolCalls and AssistantMessage (raw message JSON as UTF-8). Shared by ChatGPT
    // and Grok. Null members should already be removed (RemoveNullMembers).
    // Arguments that are not valid JSON objects are kept as received, so the tool
    // loop answers them with an "Invalid JSON arguments" error result.
    Function TranslateConversationResponse Handle hoResponse String sProvider Returns tAIResponse
        tChatGPTResponse ChatResp
        tAIResponse Response
        tAIToolCall Call
        tAIToolCall[] aCalls
        tAIResponseContentPart Part
        Handle hoChoices hoChoice hoMsg hoCalls hoCall hoFunc hoArgs
        Boolean bHas
        Integer i iCount
        String sArgs sNorm
        UChar[] ucJson

        Set pbRequireAllMembers of hoResponse to False
        Get JsonToDataType of hoResponse to ChatResp
        Get TranslateToUnified ChatResp to Response

        Get HasMember of hoResponse "choices" to bHas
        If (bHas) Begin
            Get Member of hoResponse "choices" to hoChoices
            If (MemberCount(hoChoices)>0) Begin
                Get MemberByIndex of hoChoices 0 to hoChoice
                Get HasMember of hoChoice "message" to bHas
                If (bHas) Begin
                    Get Member of hoChoice "message" to hoMsg
                    Get HasMember of hoMsg "tool_calls" to bHas
                    If (bHas) Begin
                        Get Member of hoMsg "tool_calls" to hoCalls
                        Move (MemberCount(hoCalls)) to iCount
                        For i from 0 to (iCount-1)
                            Get MemberByIndex of hoCalls i to hoCall
                            Move '' to Call.sId
                            Move '' to Call.sName
                            Move '{}' to Call.sArgumentsJson
                            Move '' to Call.sProviderData
                            Get HasMember of hoCall "id" to bHas
                            If (bHas) Get MemberValue of hoCall "id" to Call.sId
                            Get HasMember of hoCall "function" to bHas
                            If (bHas) Begin
                                Get Member of hoCall "function" to hoFunc
                                Get HasMember of hoFunc "name" to bHas
                                If (bHas) Get MemberValue of hoFunc "name" to Call.sName
                                Get HasMember of hoFunc "arguments" to bHas
                                If (bHas) Begin
                                    Get Member of hoFunc "arguments" to hoArgs
                                    If (JsonType(hoArgs)=jsonTypeString) Get MemberValue of hoFunc "arguments" to sArgs
                                    Else Begin
                                        Set peWhiteSpace of hoArgs to jpWhitespace_Plain
                                        Get Stringify of hoArgs to sArgs
                                    End
                                    Send Destroy of hoArgs
                                    Move (Trim(sArgs)) to sArgs
                                    If (sArgs='') Move '{}' to sArgs
                                    Move (AINormalizeJsonObject(sArgs)) to sNorm
                                    If (sNorm<>'') Move sNorm to Call.sArgumentsJson
                                    Else Move sArgs to Call.sArgumentsJson
                                End
                                Send Destroy of hoFunc
                            End
                            Move (SizeOfArray(aCalls)) to Call.iIndex
                            Move Call to aCalls[SizeOfArray(aCalls)]
                            Send Destroy of hoCall
                        Loop
                        Send Destroy of hoCalls
                    End
                    Set peWhiteSpace of hoMsg to jpWhitespace_Plain
                    Get StringifyUtf8 of hoMsg to ucJson
                    Send Destroy of hoMsg
                End
                Send Destroy of hoChoice
            End
            Send Destroy of hoChoices
        End

        // tool calls as content parts of choice 0
        If (SizeOfArray(Response.Choices)>0) Begin
            For i from 0 to (SizeOfArray(aCalls)-1)
                Move "tool_call" to Part.sType
                Move "assistant" to Part.sRole
                Move '' to Part.sText
                Move aCalls[i].sId to Part.sToolCallId
                Move aCalls[i].sName to Part.sFunctionName
                Move aCalls[i].sArgumentsJson to Part.sFunctionArgs
                Move Part to Response.Choices[0].ContentParts[SizeOfArray(Response.Choices[0].ContentParts)]
            Loop
            Move (AIFinalizeResponse(Response)) to Response
        End

        Move aCalls to Response.ToolCalls
        Move 'assistant' to Response.AssistantMessage.sRole
        Move Response.sText to Response.AssistantMessage.sText
        Move aCalls to Response.AssistantMessage.ToolCalls
        Move sProvider to Response.AssistantMessage.sProvider
        Move ucJson to Response.AssistantMessage.ucProviderJson
        Function_Return Response
    End_Function
    
End_Class

//=============================================================================
// Claude Response Translator  
//=============================================================================
Class cClaudeTranslator is a cObject
    
    // Translates Claude response to unified AI response structure
    Function TranslateToUnified tClaudeResponse claudeResponse Returns tAIResponse
        tAIResponse aiResponse
        tAIChoice aiChoice
        tAIResponseContentPart contentPart
        Integer i
        
        // Map basic response fields
        Move claudeResponse.id to aiResponse.sId
        Move claudeResponse.type to aiResponse.sObjectOrType
        Move (CurrentDateTime()) to aiResponse.dtCreated // Claude doesn't provide created timestamp
        Move claudeResponse.model to aiResponse.sModel
        Move claudeResponse.role to aiResponse.sRole
        
        // Map usage information
        Move claudeResponse.usage.input_tokens to aiResponse.Usage.iInputTokens
        Move claudeResponse.usage.output_tokens to aiResponse.Usage.iOutputTokens
        Move (claudeResponse.usage.input_tokens + claudeResponse.usage.output_tokens) to aiResponse.Usage.iTotalTokens
        Move claudeResponse.usage.input_tokens to aiResponse.Usage.iPromptTokens
        Move claudeResponse.usage.output_tokens to aiResponse.Usage.iCompletionTokens
        Move claudeResponse.usage.cache_creation_input_tokens to aiResponse.Usage.iCacheCreationInputTokens
        Move claudeResponse.usage.cache_read_input_tokens to aiResponse.Usage.iCacheReadInputTokens
        Move claudeResponse.usage.service_tier to aiResponse.Usage.sServiceTier
        
        // Claude has a single choice with multiple content parts
        Move 0 to aiChoice.iIndex
        Move "" to aiChoice.sFinishReason
        Move claudeResponse.stop_reason to aiChoice.sStopReason
        Move claudeResponse.stop_sequence to aiChoice.sStopSequence
        
        // Map content parts
        For i from 0 to (SizeOfArray(claudeResponse.content) - 1)
            If (claudeResponse.content[i].type='redacted_thinking') Begin
                // do nothing, grok-4 returns these sections with base64 data?
                //  not sure what to do with them --if anything, so just ignore for now
            End
            Else begin
                Move claudeResponse.content[i].type to contentPart.sType
                Move claudeResponse.role to contentPart.sRole
                Move claudeResponse.content[i].text to contentPart.sText
                Move "" to contentPart.sMimeType
                Move "" to contentPart.sData
                Move "" to contentPart.sFunctionName
                Move "" to contentPart.sFunctionArgs
                Move "" to contentPart.sFunctionContent
                Move contentPart to aiChoice.ContentParts[Sizeofarray(aiChoice.ContentParts)]
            End            
        Loop
        
        Move aiChoice to aiResponse.Choices[0]
        
        Move (AIFinalizeResponse(aiResponse)) to aiResponse
        Function_Return aiResponse
    End_Function
    
End_Class

Class cGrokTranslator is a cChatGPTTranslator
    // Grok uses the OpenAI Chat Completions format (tool_calls_plan.md, D1);
    //  a named class in case it ever differs
End_Class

//=============================================================================
// Gemini Response Translator
//=============================================================================
Class cGeminiTranslator is a cObject
    
    // Translates Gemini response to unified AI response structure
    Function TranslateToUnified tGeminiResponse geminiResponse Returns tAIResponse
        tAIResponse aiResponse
        tAIChoice aiChoice
        tAIResponseContentPart contentPart
        tAISafetyRating safetyRating
        Integer i, j, k
        
        // Check if this is an error response
//        If (geminiResponse.GeminiError.code <> 0) Begin
//            Move "" to aiResponse.sId
//            Move "error" to aiResponse.sObjectOrType
//            Move (CurrentDateTime()) to aiResponse.dtCreated
//            Move "" to aiResponse.sModel
//            Move "error" to aiResponse.sRole
//            Function_Return aiResponse
//        End
        
        // Map basic response fields (Gemini doesn't provide most of these)
        Move "" to aiResponse.sId
        Move "response" to aiResponse.sObjectOrType
        Move (CurrentDateTime()) to aiResponse.dtCreated
        Move "" to aiResponse.sModel
        Move "" to aiResponse.sRole
        
        // Gemini doesn't provide usage information in basic responses
        Move 0 to aiResponse.Usage.iPromptTokens
        Move 0 to aiResponse.Usage.iCompletionTokens
        Move 0 to aiResponse.Usage.iTotalTokens
        Move 0 to aiResponse.Usage.iInputTokens
        Move 0 to aiResponse.Usage.iOutputTokens
        Move 0 to aiResponse.Usage.iCacheCreationInputTokens
        Move 0 to aiResponse.Usage.iCacheReadInputTokens
        Move "" to aiResponse.Usage.sServiceTier
        
        // Map safety ratings from prompt feedback
        For k from 0 to (SizeOfArray(geminiResponse.promptFeedback.safetyRatings) - 1)
            Move geminiResponse.promptFeedback.safetyRatings[k].category to safetyRating.sCategory
            Move geminiResponse.promptFeedback.safetyRatings[k].probability to safetyRating.sProbability
            Move safetyRating to aiResponse.PromptFeedback.safetyRatings[k]
        Loop
        
        // Map candidates as choices
        For i from 0 to (SizeOfArray(geminiResponse.candidates) - 1)
            Move geminiResponse.candidates[i].Index to aiChoice.iIndex
            Move geminiResponse.candidates[i].finishReason to aiChoice.sFinishReason
            Move "" to aiChoice.sStopReason
            Move "" to aiChoice.sStopSequence
            
            // Map content parts from candidate
            For j from 0 to (SizeOfArray(geminiResponse.candidates[i].content.parts) - 1)
                Move "text" to contentPart.sType
                Move geminiResponse.candidates[i].content.role to contentPart.sRole
                Move geminiResponse.candidates[i].content.parts[j].text to contentPart.sText
                Move "" to contentPart.sMimeType
                Move "" to contentPart.sData
                Move "" to contentPart.sFunctionName
                Move "" to contentPart.sFunctionArgs
                Move "" to contentPart.sFunctionContent
                
                Move contentPart to aiChoice.ContentParts[j]
            Loop
            
            Move aiChoice to aiResponse.Choices[i]
        Loop
        
        Move (AIFinalizeResponse(aiResponse)) to aiResponse
        Function_Return aiResponse
    End_Function
    
End_Class

//=============================================================================
// AI Response Translator Factory
// This class provides a unified interface for all AI response translations
//=============================================================================
Class cAIResponseTranslator is a cObject
    
    // Constructor - initialize translator objects
    Procedure Construct_Object
        Forward Send Construct_Object
            
        Property Handle phoChatGPTTranslator
        Property Handle phoClaudeTranslator  
        Property Handle phoGeminiTranslator
        
        
        Object oChatGPTTranslator is a cChatGPTTranslator
        End_Object
        Set phoChatGPTTranslator to oChatGPTTranslator
        
        Object oClaudeTranslator is a cClaudeTranslator
        End_Object
        Set phoClaudeTranslator to oClaudeTranslator
        
        Object oGeminiTranslator is a cGeminiTranslator  
        End_Object
        Set phoGeminiTranslator to oGeminiTranslator
    End_Procedure
    
    // Translate ChatGPT response
    Function TranslateChatGPT tChatGPTResponse chatGPTResponse Returns tAIResponse
        Handle hoTranslator
        Get phoChatGPTTranslator to hoTranslator
        Function_Return (TranslateToUnified(hoTranslator,chatGPTResponse))
    End_Function
    
    // Translate Claude response  
    Function TranslateClaude tClaudeResponse claudeResponse Returns tAIResponse
        Handle hoTranslator
        Get phoClaudeTranslator to hoTranslator
        Function_Return (TranslateToUnified(hoTranslator,claudeResponse))
    End_Function
    
    // Translate Gemini response
    Function TranslateGemini tgeminiResponse geminiResponse Returns tAIResponse
        Handle hoTranslator
        Get phoGeminiTranslator to hoTranslator
        Function_Return (TranslateToUnified(hoTranslator,geminiResponse))
    End_Function
    
End_Class