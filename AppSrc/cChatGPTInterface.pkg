Use cAIResponseTranslator.pkg

Class cChatGPTInterface is a cAIInterface
    Procedure Construct_Object
        Forward Send Construct_Object

        Property String psHost "api.openai.com"
        Property String psTemperature '1.0'
        // gpt-4.1-nano was shut down on Oct 23, 2026. gpt-6-luna is the current low-cost
        // model; on Chat Completions it supports function calling only with
        // reasoning_effort "none", which ApplyModelSettings sends when tools are used.
        Property String psModelId "gpt-6-luna"
        Property Integer piMaxTokens 8192
        // reasoning models (o-series, gpt-5 and later): "reasoning_effort" to send.
        // '' = the model's default, except that "none" is sent when tools are in the
        // request (Chat Completions needs it for function calling on gpt-6-luna).
        Property String psReasoningEffort ''
        
        Set psApiKey to (EnvironmentVariable(ghoEnvironment, "chatgpt-api-key"))

        Object oChatGPTRequest is a cChatGPTRequest
        End_Object
        
        Object oChatGPTTranslator is a cChatGPTTranslator
        End_Object

    End_Procedure

    // True for OpenAI reasoning models (o1/o3/o4..., gpt-5 and later, except the
    // gpt-5 "chat" variants). They take max_completion_tokens instead of max_tokens.
    // Override for models this rule gets wrong.
    Function IsReasoningModel String sModel Returns Boolean
        String sLower sRest sMajor sChar
        Integer i
        Move (Lowercase(Trim(sModel))) to sLower
        If (Left(sLower,1)='o' and Length(sLower)>1) Begin
            Move (Mid(sLower,1,2)) to sChar
            If (sChar>='0' and sChar<='9') Function_Return True
        End
        If (Left(sLower,4)<>'gpt-') Function_Return False
        If (Pos('-chat',sLower)>0) Function_Return False
        Move (Right(sLower,Length(sLower)-4)) to sRest
        Move 1 to i
        Move (Mid(sRest,1,1)) to sChar
        While (i<=Length(sRest) and sChar>='0' and sChar<='9')
            Move (sMajor+sChar) to sMajor
            Increment i
            Move (Mid(sRest,1,i)) to sChar
        Loop
        If (sMajor='') Function_Return False
        Function_Return (Integer(sMajor)>=5)
    End_Function

    // per-request token/effort members for the model in psModelId
    Procedure ApplyModelSettings Boolean bTools
        Handle hoReq
        String sEffort
        Boolean bReasoning
        Move (oChatGPTRequest(Self)) to hoReq
        Get IsReasoningModel (psModelId(Self)) to bReasoning
        Move '' to sEffort
        If (bReasoning) Begin
            Set psMaxTokensMember of hoReq to "max_completion_tokens"
            Get psReasoningEffort to sEffort
            If (sEffort='' and bTools) Move "none" to sEffort
        End
        Else Set psMaxTokensMember of hoReq to "max_tokens"
        Set psReasoningEffort of hoReq to sEffort
    End_Procedure

    //-----------------------------------------------------------------------------
    // Add headers required for ChatGPT API calls
    //-----------------------------------------------------------------------------
    Procedure AddStandardHeaders
        Integer iRetVal
        
        Send ClearHeaders
        Get AddHeader "Authorization" ("Bearer " + psApiKey(Self)) to iRetVal
        Set psContentTypeSent to "application/json"
        
        //Get AddHeader "Content-Type" "application/json" to iRetVal
    End_Procedure

    //-----------------------------------------------------------------------------
    // Function to retrieve the list of available ChatGPT models
    //-----------------------------------------------------------------------------
    Function ModelList Returns tAIModel[]
        Boolean bOk
        Handle hoResponse
        tChatGPTModelList chatModelList
        tAIModel[] ModelList
        Integer i iCnt

        Get paModels to ModelList
        If (SizeOfArray(ModelList)=0) Begin
            If (CheckApiKeyExists(Self)) Begin
                // Add required headers
                Send AddStandardHeaders
    
                // Call ChatGPT API
                Get HttpGetJson (psHost(Self)) "v1/models" (&bOk) to hoResponse
        
                If (not(bOk)) Begin
                    Send ReportAIError AI_ERR_TRANSFER (TransferErrorDescription(Self)) "Transfer failed!"
                End
                Else Begin
                    // Parse JSON 2 DataFlex struct
                    Set pbRequireAllMembers of hoResponse to False
                    Get JsonToDataType of hoResponse to chatModelList
                    Send Destroy of hoResponse
                End
                // Populate unified tAIModel array
                Move (SizeOfArray(chatModelList.data)-1) to iCnt
                For i from 0 to iCnt
                    Move (chatModelList.data[i].id)       to ModelList[i].id
                    Move ModelList[i].id to ModelList[i].display_name
                    Move (chatModelList.data[i].sObject)   to ModelList[i]._object
                    Move (chatModelList.data[i].created)  to ModelList[i].created
                    Move (chatModelList.data[i].owned_by) to ModelList[i].owned_by
        
                    // Fields not provided by ChatGPT models API
                    Move "" to ModelList[i].type
                    Move "" to ModelList[i].created_at
                Loop
                Set paModels to ModelList
            End
        End
        
        Function_Return ModelList
    End_Function

    //-----------------------------------------------------------------------------
    // Function to request a chat completion
    //-----------------------------------------------------------------------------
    Function CreateChatCompletion String sModel tChatGPTMessage[] Messages Integer iMaxTokens String sTemperature Returns tChatGPTResponse
        Handle hoJson hoReq
        Boolean bOk
        Handle hoResponse
        tChatGPTResponse ChatResp

        Send ClearLastError
        Get Create (RefClass(cChatGPTRequest)) to hoReq
        If (IsReasoningModel(Self,sModel)) Begin
            Set psMaxTokensMember of hoReq to "max_completion_tokens"
            Set psReasoningEffort of hoReq to (psReasoningEffort(Self))
        End
        Get ConstructRequest of hoReq sModel Messages iMaxTokens sTemperature to hoJson

        // Add required headers
        Send AddStandardHeaders

        Get HttpPostJson (psHost(Self)) "v1/chat/completions" hoJson (&bOk) to hoResponse

        If (not(bOk)) Begin
            Send ReportAIError AI_ERR_TRANSFER (TransferErrorDescription(Self)) "Transfer failed!"
        End
        Else Begin
            Get JsonToDataType of hoResponse to ChatResp
            Send Destroy of hoResponse
        End

        Send Destroy of hoJson
        Send Destroy of hoReq

        Function_Return ChatResp
    End_Function

    //-----------------------------------------------------------------------------
    // Function to create a ChatGPT request JSON object from a prompt + attachments
    //-----------------------------------------------------------------------------
    Function CreateRequest String sPrompt tAIAttachment[] Attachments Returns Handle
        Handle hoRequest hoJson
        tChatGPTMessage[] aMessages
        Integer i iCnt

        // Add the prompt as the first message
        Move "user"   to aMessages[0].role
        Move sPrompt  to aMessages[0].content

        // Convert attachments into additional user messages
        Move (SizeOfArray(Attachments)-1) to iCnt
        For i from 0 to iCnt
            Move "user" to aMessages[i+1].role
            Move ("Attachment ("+Attachments[i].sMimeType+"): " + ;
                 (UCharArrayToString(Attachments[i].uBase64File))) to aMessages[i+1].content
        Loop

        // Call the request builder to build JSON
        Send ApplyModelSettings False
        Get ConstructRequest of (oChatGPTRequest(Self)) (psModelId(Self)) aMessages (piMaxTokens(Self)) (psTemperature(Self)) to hoJson

        Move hoJson to hoRequest
        Function_Return hoRequest
    End_Function  

    //-----------------------------------------------------------------------------
    // Send the request to ChatGPT and return a JSON object containing its response
    //-----------------------------------------------------------------------------
    Function MakeRequestJSON Handle hoRequest Returns Handle
        Handle hoResponse hoError
        Boolean bOk
        String sMessage

        If (CheckApiKeyExists(Self)) Begin
            Send AddStandardHeaders

            // POST the request JSON to the Chat Completions endpoint
            Get HttpPostJson (psHost(Self)) "v1/chat/completions" hoRequest (&bOk) to hoResponse

            If (not(bOk)) Begin
                Send ReportAIError AI_ERR_TRANSFER (TransferErrorDescription(Self)) "Transfer failed!"
                Move 0 to hoResponse
            End
            Else Begin
                Send RemoveNullMembers hoResponse
    
                // Check for error object in response
                If (HasMember(hoResponse, "error")) Begin
                    Get Member of hoResponse "error" to hoError
                    Get MemberValue of hoError "message" to sMessage
    
                    Send ReportAIError AI_ERR_API sMessage "API Error"
                    Send Destroy of hoResponse
                    Move 0 to hoResponse
                End
            End
        End
        
        Function_Return hoResponse
    End_Function

    Function MakeRequest Handle hoRequest Returns tAIResponse
        Handle hoResponse
        tChatGPTResponse ChatGPTResponse
        tAIResponse Response
        
        Set peWhiteSpace of hoRequest to jpWhitespace_Pretty
        Set psModelRequestJson to (Stringify(hoRequest))
        Get MakeRequestJSON hoRequest to hoResponse
        //
        If (hoResponse) Begin
            Set peWhiteSpace of hoResponse to jpWhitespace_Pretty
            Set psModelResponseJson to (Stringify(hoResponse))
            Set pbRequireAllMembers of hoResponse to False
            Get JsonToDataType of hoResponse to ChatGPTResponse
            Send Destroy of hoResponse
            //
            Get TranslateToUnified of oChatGPTTranslator ChatGPTResponse to Response
        End
        Else Move AI_STOP_ERROR to Response.eStopReason
        
        Function_Return Response
    End_Function
    // provider id used in conversation history
    Function ProviderName Returns String
        Function_Return "chatgpt"
    End_Function

    //=========================================================================
    // Conversation with tools (tool_calls_plan.md, Phase 4)
    //=========================================================================

    Function BuildConversationRequest tAIMessage[] Messages tAIToolDefinition[] Tools Returns Handle
        Handle hoRequest
        Send ApplyModelSettings (SizeOfArray(Tools)>0)
        Get ConstructConversationRequest of (oChatGPTRequest(Self)) (psModelId(Self)) (piMaxTokens(Self)) Messages Tools (EffectiveSystemPrompt(Self)) (peToolChoice(Self)) (psToolChoiceName(Self)) (pbParallelToolCalls(Self)) to hoRequest
        Function_Return hoRequest
    End_Function

    Function ParseConversationResponse Handle hoResponse Returns tAIResponse
        tAIResponse Response
        Send RemoveNullMembers hoResponse
        Get TranslateConversationResponse of oChatGPTTranslator hoResponse (ProviderName(Self)) to Response
        Function_Return Response
    End_Function

End_Class
