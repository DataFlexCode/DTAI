Use cAIResponseTranslator.pkg

Class cGeminiInterface is a cAIInterface

    Procedure Construct_object
        Forward Send Construct_Object

        Property String psHost "generativelanguage.googleapis.com"
        // gemini-2.5-flash is deprecated; from Dec 1, 2026 its requests are routed to
        // gemini-3.5-flash-lite. gemini-3.8-flash is the current stable Flash model.
        Property String psModelId "models/gemini-3.8-flash"
        Property Integer piMaxTokens 8192
        
        Property tGenerationConfig pGenerationConfig        
        Property Integer piCallSequence 0   // numbers the ids generated for calls without one

        Set psApiKey to (EnvironmentVariable(ghoEnvironment,'gemini-api-key')) 

        Object oGeminiRequest is a cGeminiRequest
        End_Object
        
        Object oGeminiTranslator is a cGeminiTranslator
        End_Object
    End_Procedure

    Procedure AddStandardHeaders 
        Integer iRetVal 
        Set pbClearHeaders to False
        Send ClearHeaders
        Set psContentTypeSent to "application/json"
    End_Procedure

    // send the request to the AI and return a JSON object containing its response 
    Function MakeRequestJSON Handle hoRequest Returns Handle
        Handle hoResponse
        String sUrl
        Boolean bOk

        If (CheckApiKeyExists(Self)) Begin
            // Construct the full URL with the model ID and API key
             Move ("v1beta/" + psModelId(Self) + ":generateContent?key=" + psApiKey(Self)) to sUrl
            // Move ("v1beta/models/" + psModelId(Self) + ":generateContent?key=" + psApiKey(Self)) to sUrl

            Send AddStandardHeaders
            
            Get httpPostJson (psHost(Self)) sUrl hoRequest (&bOk) to hoResponse

            If (not(bOk)) Begin
                Send ReportAIError AI_ERR_TRANSFER (TransferErrorDescription(Self)) "Transfer failed!"
            End
            Else If (hoResponse<>0) Begin
                Send RemoveNullMembers hoResponse
                If (HasMember(hoResponse,'candidates')) Begin
                    // success!
                    // Just return the handle
                End
                // check for an error object in the response
                If (HasMember(hoResponse, "error")) Begin
                    Handle hoError
                    String sMessage
                    
                    Get Member of hoResponse "error" to hoError
                    Get MemberValue of hoError "message" to sMessage
                    
                    Send ReportAIError AI_ERR_API sMessage "API Error"                
                    Send Destroy of hoResponse
                    Move 0 to hoResponse
                End
            End
            Else Begin
                String sResponse
                Get DataReceived to sResponse
                Send ReportAIError AI_ERR_PARSE ("Response was not JSON:" * Left(sResponse,1000)) "API Error"
            End
        End
        Function_Return hoResponse
    End_Function

    //-----------------------------------------------------------------------------
    // Function to retrieve the list of available Gemini models
    //-----------------------------------------------------------------------------
    Function ModelList Returns tAIModel[]
        Boolean bOk
        Handle hoResponse
        tGeminiModelList geminiModelList
        tAIModel[] ModelList        
        Integer i iCnt
    
        Get paModels to ModelList
        If (SizeOfArray(ModelList)=0) Begin
            If (CheckApiKeyExists(Self)) Begin
                // Add required headers for the API call
                Send AddStandardHeaders
            
                // Construct the full URL with the API key
                Get HttpGetJson (psHost(Self)) ("/v1beta/models?key=" + psApiKey(Self)) (&bOk) to hoResponse
        
                // Check for a successful transfer
                If (not(bOk)) Begin
                    Send ReportAIError AI_ERR_TRANSFER (TransferErrorDescription(Self)) "Transfer failed!"
                End
                Else Begin
                    // Deserialize the JSON response into our DataFlex struct
                    Set pbRequireAllMembers of hoResponse to False
                    Get JsonToDataType of hoResponse to geminiModelList
                    Send Destroy of hoResponse
                End
            
                // Populate the return array with model information
                Move (Sizeofarray(geminiModelList.models)-1) to iCnt
                For i from 0 to iCnt
                    Move (geminiModelList.models[i].name) to ModelList[i].id
                    Move (geminiModelList.models[i].displayName) to ModelList[i].display_name
                    
                    // Note: The Gemini API does not provide created_at or type fields in this response.
                    // These will remain empty in the tAIModel struct.
                    Move "" to ModelList[i].created_at
                    Move "" to ModelList[i].type
                Loop
                Set paModels to ModelList
            End
        End
        
        Function_Return ModelList
    End_Function

    // standard entry point for creating all AI requests. the first paramter is a text prompt that needs to
    //  be supplied to the AI, the tAIAttachments array has optional files in base64 format
    //  both need to be converted into equivalent Gemini "parts", then call the CreateGeminiApiJsonRequest 
    // function in the oGeminiRequest object to create the request
    //  
    //  Struct tAIAttachment
    //      UChar[] uBase64File
    //      String sMimeType
    //      String sFileID
    //  End_Struct

    Function CreateRequest String sPrompt tAIAttachment[] Attachments Returns Handle 
        Handle hoRequest
        tGeminiPart[] aParts
        Integer iAttachmentCount i

        // Convert the prompt into a Gemini part and add it to the parts array
        Move "user" to aParts[0].sRole
        Move "text" to aParts[0].sPartType
        Move sPrompt to aParts[0].sText

        // Convert the attachments into Gemini parts and add them to the parts array
        Move (SizeOfArray(Attachments)-1) to iAttachmentCount
        For i from 0 to iAttachmentCount
            Move "user" to aParts[i+1].sRole
            Move "inlineData" to aParts[i+1].sPartType
            Move Attachments[i].sMimeType to aParts[i+1].sMimeType
            Move (UCharArrayToString(Attachments[i].uBase64File)) to aParts[i+1].sData
        Loop

        // Call the cGeminiRequest object's function to build the JSON request
        Get CreateGeminiApiJsonRequest of oGeminiRequest (psModelId(Self)) aParts (pGenerationConfig(Self))  to hoRequest
        
        Function_Return hoRequest
    End_Function

    Function MakeRequest Handle hoRequest Returns tAIResponse
        Handle hoResponse
        tGeminiResponse GeminiResponse
        tAIResponse Response
        
        Set peWhiteSpace of hoRequest to jpWhitespace_Pretty
        Set psModelRequestJson to (Stringify(hoRequest))
        Get MakeRequestJSON hoRequest to hoResponse
        //
        If (hoResponse) Begin
            Set peWhiteSpace of hoResponse to jpWhitespace_Pretty
            Set psModelResponseJson to (Stringify(hoResponse))
            Set pbRequireAllMembers of hoResponse to False
            Get JsonToDataType of hoResponse to GeminiResponse
            Send Destroy of hoResponse
            //
            Get TranslateToUnified of oGeminiTranslator GeminiResponse to Response
        End
        Else Move AI_STOP_ERROR to Response.eStopReason
        
        Function_Return Response
    End_Function

    // provider id used in conversation history
    Function ProviderName Returns String
        Function_Return "gemini"
    End_Function

    //=========================================================================
    // Conversations and tool calls (tool_calls_plan.md, Phase 6)
    //=========================================================================

    Function BuildConversationRequest tAIMessage[] Messages tAIToolDefinition[] Tools Returns Handle
        Handle hoRequest
        Get CreateGeminiConversationRequest of oGeminiRequest Messages Tools (EffectiveSystemPrompt(Self)) (peToolChoice(Self)) (psToolChoiceName(Self)) (pGenerationConfig(Self)) (piMaxTokens(Self)) to hoRequest
        Function_Return hoRequest
    End_Function

    Function JsonMemberText Handle hoJson String sMember Returns String
        Boolean bHas
        String sValue
        Get HasMember of hoJson sMember to bHas
        If (bHas) Get MemberValue of hoJson sMember to sValue
        Function_Return sValue
    End_Function

    // Translates a generateContent response (hoResponse is not destroyed).
    // functionCall parts become ToolCalls: the id is Gemini's when it sends one,
    // else "gemini-call-<n>" (not sent back; results are then matched by name and
    // order). A part's thoughtSignature is kept in sProviderData. Thought summary
    // parts are not part of sText. AssistantMessage keeps the raw candidate content
    // {"role":"model","parts":[...]} as UTF-8 so it is replayed exactly.
    Function ParseConversationResponse Handle hoResponse Returns tAIResponse
        tGeminiResponse GeminiResponse
        tAIResponse Response
        tAIResponseContentPart Part EmptyPart
        tAIResponseContentPart[] aParts
        tAIToolCall Call
        tAIToolCall[] aCalls
        Handle hoCandidates hoCand hoContent hoParts hoPart hoFn hoArgs hoUsage hoFeedback
        Integer i iCount iSeq
        Boolean bHas
        String sThought sArgs sBlock
        UChar[] ucJson

        Send RemoveNullMembers hoResponse
        Set pbRequireAllMembers of hoResponse to False
        Get JsonToDataType of hoResponse to GeminiResponse
        Get TranslateToUnified of oGeminiTranslator GeminiResponse to Response

        Get HasMember of hoResponse "usageMetadata" to bHas
        If (bHas) Begin
            Get Member of hoResponse "usageMetadata" to hoUsage
            Move (Integer(JsonMemberText(Self,hoUsage,"promptTokenCount"))) to Response.Usage.iPromptTokens
            Move (Integer(JsonMemberText(Self,hoUsage,"candidatesTokenCount"))) to Response.Usage.iCompletionTokens
            Move (Integer(JsonMemberText(Self,hoUsage,"totalTokenCount"))) to Response.Usage.iTotalTokens
            Move Response.Usage.iPromptTokens to Response.Usage.iInputTokens
            Move Response.Usage.iCompletionTokens to Response.Usage.iOutputTokens
            Send Destroy of hoUsage
        End
        Get HasMember of hoResponse "modelVersion" to bHas
        If (bHas) Get MemberValue of hoResponse "modelVersion" to Response.sModel
        Get HasMember of hoResponse "responseId" to bHas
        If (bHas) Get MemberValue of hoResponse "responseId" to Response.sId

        Get HasMember of hoResponse "candidates" to bHas
        If (bHas) Begin
            Get Member of hoResponse "candidates" to hoCandidates
            If (MemberCount(hoCandidates)=0) Move False to bHas
            Else Get MemberByIndex of hoCandidates 0 to hoCand
            Send Destroy of hoCandidates
        End
        If (not(bHas)) Begin
            // prompt blocked: no candidates, promptFeedback.blockReason says why
            Get HasMember of hoResponse "promptFeedback" to bHas
            If (bHas) Begin
                Get Member of hoResponse "promptFeedback" to hoFeedback
                Get JsonMemberText hoFeedback "blockReason" to sBlock
                Send Destroy of hoFeedback
            End
            If (sBlock<>'') Move AI_STOP_CONTENT_FILTER to Response.eStopReason
            Move 'assistant' to Response.AssistantMessage.sRole
            Move (ProviderName(Self)) to Response.AssistantMessage.sProvider
            Function_Return Response
        End

        Get HasMember of hoCand "content" to bHas
        If (bHas) Begin
            Get Member of hoCand "content" to hoContent
            Get HasMember of hoContent "parts" to bHas
            If (bHas) Begin
                Get Member of hoContent "parts" to hoParts
                Get MemberCount of hoParts to iCount
                For i from 0 to (iCount-1)
                    Get MemberByIndex of hoParts i to hoPart
                    Move EmptyPart to Part
                    Move "model" to Part.sRole
                    Get JsonMemberText hoPart "thought" to sThought
                    Get HasMember of hoPart "functionCall" to bHas
                    If (bHas) Begin
                        Get Member of hoPart "functionCall" to hoFn
                        Get JsonMemberText hoFn "name" to Call.sName
                        Get JsonMemberText hoFn "id" to Call.sId
                        If (Call.sId='') Begin
                            Get piCallSequence to iSeq
                            Increment iSeq
                            Set piCallSequence to iSeq
                            Move ("gemini-call-"+String(iSeq)) to Call.sId
                        End
                        Move '{}' to Call.sArgumentsJson
                        Get HasMember of hoFn "args" to bHas
                        If (bHas) Begin
                            Get Member of hoFn "args" to hoArgs
                            If (JsonType(hoArgs)=jsonTypeObject) Begin
                                Set peWhiteSpace of hoArgs to jpWhitespace_Plain
                                Get Stringify of hoArgs to sArgs
                                Move sArgs to Call.sArgumentsJson
                            End
                            Send Destroy of hoArgs
                        End
                        Get JsonMemberText hoPart "thoughtSignature" to Call.sProviderData
                        Move (SizeOfArray(aCalls)) to Call.iIndex
                        Move Call to aCalls[SizeOfArray(aCalls)]
                        Send Destroy of hoFn
                        Move "tool_call" to Part.sType
                        Move Call.sId to Part.sToolCallId
                        Move Call.sName to Part.sFunctionName
                        Move Call.sArgumentsJson to Part.sFunctionArgs
                        Move Part to aParts[SizeOfArray(aParts)]
                    End
                    Else Begin
                        Get HasMember of hoPart "text" to bHas
                        // thought summaries are not answer text
                        If (bHas and Lowercase(sThought)<>'true' and sThought<>'1') Begin
                            Move "text" to Part.sType
                            Get MemberValue of hoPart "text" to Part.sText
                            Move Part to aParts[SizeOfArray(aParts)]
                        End
                    End
                    Send Destroy of hoPart
                Loop
                Send Destroy of hoParts
            End
            Get HasMember of hoContent "role" to bHas
            If (not(bHas)) Send SetMemberValue of hoContent "role" jsonTypeString "model"
            Set peWhiteSpace of hoContent to jpWhitespace_Plain
            Get StringifyUtf8 of hoContent to ucJson
            Send Destroy of hoContent
        End
        Send Destroy of hoCand

        If (SizeOfArray(Response.Choices)>0) Begin
            Move aParts to Response.Choices[0].ContentParts
            Move (AIFinalizeResponse(Response)) to Response
        End

        Move aCalls to Response.ToolCalls
        Move 'assistant' to Response.AssistantMessage.sRole
        Move Response.sText to Response.AssistantMessage.sText
        Move aCalls to Response.AssistantMessage.ToolCalls
        Move (ProviderName(Self)) to Response.AssistantMessage.sProvider
        Move ucJson to Response.AssistantMessage.ucProviderJson
        Function_Return Response
    End_Function

End_Class
