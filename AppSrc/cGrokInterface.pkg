Use cAIResponseTranslator.pkg

// Grok on the OpenAI-compatible Chat Completions endpoint (tool_calls_plan.md, D1).
// Requests are built with cChatGPTRequest and responses read with cGrokTranslator
// (a cChatGPTTranslator). The deprecated /v1/messages endpoint is no longer used.
Class cGrokInterface is a cAiInterface

    Procedure construct_object
        Forward Send Construct_Object
        
        Property String psHost "api.x.ai" // xAI API endpoint
        // grok-3 was retired on May 15, 2026 (requests are redirected to grok-4.3);
        // xAI recommends grok-4.7 for chat and code
        Property String psModelId "grok-4.7"
        Property Integer piMaxTokens 256000

        Set psApiKey to (EnvironmentVariable(ghoEnvironment,'grok-api-key'))
        
        Object oGrokRequest is a cChatGPTRequest
            Set pbFileParts to False   // xAI chat completions: images yes, PDF file parts no
        End_Object
        
        Object oGrokTranslator is a cGrokTranslator
        End_Object
    End_Procedure

    Procedure end_construct_object
        Forward Send End_Construct_Object
    End_Procedure

 
    Procedure AddStandardHeaders String sContentType
        Integer iRetVal 
        Set pbClearHeaders to False

        Send ClearHeaders
        Set psContentTypeSent to "application/json" // grok is sensitive about this
        Get AddHeader "Cache-Control" "no-cache" to iRetVal
        Get AddHeader "Accept" "*/*" to iRetVal
        Get AddHeader "Authorization" ("Bearer "+psApiKey(Self)) to iRetVal
    End_Procedure
    
    // returns the response JSON, or 0 after reporting a transfer or API error
    Function MakeRequestJSON Handle hoRequest Returns Handle
        Boolean bError bHas
        Handle hoResponse hoError
        String sResponseType sMessage
        Boolean bOk
        
        If (CheckApiKeyExists(Self)) Begin
            Send SetTimeout 45
            
            Send AddStandardHeaders
            Get httpPostJson (psHost(Self)) "v1/chat/completions" hoRequest (&bOk) to hoResponse
            If (not(bOk)) Begin
                If (left(psContentTypeReceived(Self),10)='text/plain') Begin
                    If (not(pbSilentErrors(Self))) Send info_box (DataReceived(Self)) "Text Response"
                End
                Send ReportAIError AI_ERR_TRANSFER (TransferErrorDescription(Self)) "Transfer failed!"
                Move 0 to hoResponse
            End
            Else Begin
                Send RemoveNullMembers hoResponse
                // xAI: {"code":"...","error":"..."}; OpenAI style: {"error":{"message":"...","type":"..."}}
                Get HasMember of hoResponse 'error' to bError
                If (bError) Begin
                    Move '' to sMessage
                    Move '' to sResponseType
                    Get Member of hoResponse "error" to hoError
                    If (JsonType(hoError)=jsonTypeObject) Begin
                        Get HasMember of hoError "message" to bHas
                        If (bHas) Get MemberValue of hoError "message" to sMessage
                        Get HasMember of hoError "type" to bHas
                        If (bHas) Get MemberValue of hoError "type" to sResponseType
                    End
                    Else Get MemberValue of hoResponse "error" to sMessage
                    Send Destroy of hoError
                    Get HasMember of hoResponse "code" to bHas
                    If (bHas and sResponseType='') Get MemberValue of hoResponse "code" to sResponseType
                    If (sResponseType='') Move "API Error" to sResponseType
                    Send ReportAIError AI_ERR_API sMessage sResponseType
                    Send Destroy of hoResponse
                    Move 0 to hoResponse
                End
            End
        End
        
        Function_Return hoResponse
    End_Function
    
    Function ModelList Returns tAIModel[]
        Integer i iCnt
        Boolean bOk
        Handle hoResponse
        tGrokModelList GrokModelList
        tAIModel[] ModelList
        
        Get paModels to ModelList
        If (SizeOfArray(ModelList)=0) Begin
            If (CheckApiKeyExists(Self)) Begin
                Send AddStandardHeaders
                Get HttpGetJson (psHost(Self)) "v1/models" (&bOk) to hoResponse
                If (not(bOk)) Begin
                    Send ReportAIError AI_ERR_TRANSFER (TransferErrorDescription(Self)) "Transfer failed!"
                End
                Else Begin
                    Set pbRequireAllMembers of hoResponse to False
                    Get JsonToDataType of hoResponse to GrokModelList
                    Send Destroy of hoResponse
                End
                Move (Sizeofarray(GrokModelList.data)-1) to iCnt
                For i from 0 to iCnt
                    Move (GrokModelList.data[i].id) to ModelList[i].id
                    Move ModelList[i].id to ModelList[i].display_name       // no separate display name
                    Move GrokModelList.data[i].type to ModelList[i].type
                Loop
                Set paModels to ModelList
            End
        End        
        
        Function_Return ModelList
    End_Function
    
    // single-turn request in Chat Completions format; attachments are optional
    Function CreateRequest String sPrompt tAIAttachment[] Attachments Returns Handle 
        Handle hoRequest
        tAIMessage[] aMessages
        tAIToolDefinition[] aNoTools
        
        Move "user" to aMessages[0].sRole
        Move sPrompt to aMessages[0].sText
        If (num_arguments>1) Move Attachments to aMessages[0].Attachments
        Get ConstructConversationRequest of (oGrokRequest(Self)) (psModelId(Self)) (piMaxTokens(Self)) aMessages aNoTools '' AI_TOOLCHOICE_AUTO '' True to hoRequest
        Function_Return hoRequest
    End_Function
    
    Function MakeRequest Handle hoRequest Returns tAIResponse
        Handle hoResponse
        tChatGPTResponse GrokResponse
        tAIResponse Response
        
        Set peWhiteSpace of hoRequest to jpWhitespace_Pretty
        Set psModelRequestJson to (Stringify(hoRequest))
        Get MakeRequestJSON hoRequest to hoResponse
        //
        If (hoResponse) Begin
            Set peWhiteSpace of hoResponse to jpWhitespace_Pretty
            Set psModelResponseJson to (Stringify(hoResponse))
            Set pbRequireAllMembers of hoResponse to False
            Get JsonToDataType of hoResponse to GrokResponse
            Send Destroy of hoResponse
            //
            Get TranslateToUnified of oGrokTranslator GrokResponse to Response
        End
        Else Move AI_STOP_ERROR to Response.eStopReason
        
        Function_Return Response
    End_Function

    // provider id used in conversation history
    Function ProviderName Returns String
        Function_Return "grok"
    End_Function

    //=========================================================================
    // Conversation with tools (tool_calls_plan.md, Phase 5)
    //=========================================================================

    Function BuildConversationRequest tAIMessage[] Messages tAIToolDefinition[] Tools Returns Handle
        Handle hoRequest
        Get ConstructConversationRequest of (oGrokRequest(Self)) (psModelId(Self)) (piMaxTokens(Self)) Messages Tools (EffectiveSystemPrompt(Self)) (peToolChoice(Self)) (psToolChoiceName(Self)) (pbParallelToolCalls(Self)) to hoRequest
        Function_Return hoRequest
    End_Function

    Function ParseConversationResponse Handle hoResponse Returns tAIResponse
        tAIResponse Response
        Send RemoveNullMembers hoResponse
        Get TranslateConversationResponse of oGrokTranslator hoResponse (ProviderName(Self)) to Response
        Function_Return Response
    End_Function

End_Class
